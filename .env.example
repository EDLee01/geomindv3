# GeoMind 4.0 环境变量配置
# 复制此文件为 .env 并填入你的 API Key

# ============================================================
# LLM API Keys（至少配置一个）
# ============================================================

# Anthropic Claude（官方 API，需要海外网络）
# CLAUDE_API_KEY=sk-ant-xxx

# Claude via Zeabur AI Hub（国内可用，推荐）
CLAUDE_ZEABUR_API_KEY=

# Kimi via Zeabur AI Hub（国内可用，推荐）
KIMI_ZEABUR_API_KEY=

# Moonshot Kimi（官方 API，需要直连）
# KIMI_API_KEY=

# DeepSeek
# DEEPSEEK_API_KEY=

# ============================================================
# 文献检索（Qdrant 向量数据库）
# ============================================================

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=geomind_papers

# ============================================================
# 用户系统（启用后支持注册、登录和对话保存）
# ============================================================

# 启用用户认证（必填，设置任意字符串即可）
CHAINLIT_AUTH_SECRET=your-secret-key-here

# 数据库路径（用于存储用户和对话历史）
GEOMIND_DB_PATH=data/geomind.db

# ============================================================
# 注册和登录说明
# ============================================================
#
# 登录: 直接输入用户名和密码
#
# 注册: 用户名填写 "用户名|邮箱" 格式，如:
#       用户名: edward|edward@example.com
#       密码: your-password
#
# 注册成功后，下次登录只需输入用户名和密码
