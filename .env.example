# GeoMind 4.0 环境变量配置
# 复制此文件为 .env 并填入你的 API Key

# ============================================================
# LLM API Keys（至少配置一个）
# ============================================================

# Anthropic Claude（官方 API，需要海外网络）
# CLAUDE_API_KEY=sk-ant-xxx

# Claude via Zeabur AI Hub（国内可用，推荐）
CLAUDE_ZEABUR_API_KEY=

# Kimi via Zeabur AI Hub（国内可用，推荐）
KIMI_ZEABUR_API_KEY=

# Moonshot Kimi（官方 API，需要直连）
# KIMI_API_KEY=

# DeepSeek
# DEEPSEEK_API_KEY=

# ============================================================
# 文献检索（可选）
# ============================================================

# Qdrant 向量数据库
# QDRANT_URL=https://your-qdrant-instance.cloud
# QDRANT_API_KEY=
