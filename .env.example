# ============================================================
# GeoMind 4.0 - 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# ============================================================

# ------------------------------------------------------------
# LLM API Keys（至少配置一个）
# ------------------------------------------------------------

# Anthropic Claude（原生 API）
CLAUDE_API_KEY=sk-ant-api03-xxxxx

# Claude via Zeabur（国内可用代理）
CLAUDE_ZEABUR_API_KEY=your_zeabur_claude_key

# Moonshot Kimi
KIMI_API_KEY=sk-xxxxx

# DeepSeek
DEEPSEEK_API_KEY=sk-xxxxx

# ------------------------------------------------------------
# Qdrant 文献库配置（Zeabur 部署时必填）
# ------------------------------------------------------------

# Qdrant 服务地址
QDRANT_URL=https://your-qdrant-instance.cloud.qdrant.io:6333

# Qdrant API Key
QDRANT_API_KEY=your_qdrant_api_key

# Qdrant 集合名称（默认: geomind_papers）
QDRANT_COLLECTION=geomind_papers

# ------------------------------------------------------------
# 用户认证配置（三选一）
# ------------------------------------------------------------

# 方式 1: 单用户模式（最简单）
GEOMIND_DEFAULT_USER=admin
GEOMIND_DEFAULT_PASSWORD=your_secure_password

# 方式 2: 多用户 JSON 配置（适合 Zeabur）
# 密码需要先用 SHA256 哈希
# Python: hashlib.sha256("your_password".encode()).hexdigest()
# GEOMIND_USERS={"user1":{"password":"hashed_password","role":"admin","name":"显示名称"},"user2":{"password":"hashed_password","role":"user","name":"用户2"}}

# 方式 3: users.json 文件（适合本地开发）
# 在项目根目录创建 users.json 文件，格式同上

# ------------------------------------------------------------
# Chainlit 配置（可选）
# ------------------------------------------------------------

# Chainlit 服务端口
CHAINLIT_PORT=8000

# 认证密钥（用于 session 加密，建议设置）
CHAINLIT_AUTH_SECRET=your_random_secret_string

# ------------------------------------------------------------
# Zeabur 部署专用（自动设置，无需手动填写）
# ------------------------------------------------------------

# ZEABUR_GIT_REPO_URL - 自动设置
# ZEABUR_SERVICE_ID - 自动设置
